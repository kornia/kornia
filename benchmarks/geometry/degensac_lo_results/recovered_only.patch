+    @pytest.mark.parametrize("plane_fraction", [0.0, 0.95])
+    def test_recovered_candidates_bypass_repeated_lo(self, device, dtype, monkeypatch, plane_fraction):
+        _skip_half(dtype)
+        recovered, ordinary, final = [], [], []
+        inside_recovery = False
+        original_recover, original_refine = RANSAC._degensac_recover, RANSAC._lm_refine
+
+        def recover(self, *args):
+            nonlocal inside_recovery
+            inside_recovery = True
+            try:
+                result = original_recover(self, *args)
+            finally:
+                inside_recovery = False
+            if result is not None:
+                recovered.extend(result[0].cpu().double().clone())
+            return result
+
+        def refine(self, models, x1, x2, mask, loss, scale2, iters):
+            if loss == "truncated" and not inside_recovery:
+                ordinary.extend(models.clone())
+            if loss == "cauchy":
+                final.append(len(models))
+            return original_refine(self, models, x1, x2, mask, loss, scale2, iters)
+
+        monkeypatch.setattr(RANSAC, "_degensac_recover", recover)
+        monkeypatch.setattr(RANSAC, "_lm_refine", refine)
+        kp1, kp2, _, clean1, clean2 = create_dominant_plane_scene(
+            1000, 0.6, plane_fraction, 0, device=device, dtype=dtype
+        )
+        F, _ = RANSAC("fundamental", inl_th=1.0, seed=0, degensac=True)(kp1, kp2)
+        if plane_fraction > 0:
+            assert recovered
+        assert ordinary  # raw candidates must still receive their first LO, alongside any recovered candidates
+        assert all(not torch.equal(model, skipped) for model in ordinary for skipped in recovered)
+        assert final == [1]
+        assert _explains_off_plane(F.cpu(), clean1.cpu(), clean2.cpu())
+
