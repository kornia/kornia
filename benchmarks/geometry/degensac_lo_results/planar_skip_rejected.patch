+
+        def check(raw_models, raw_x1, raw_x2, threshold):
+            assert torch.equal(raw_models, models[[0, 2]])
+            assert torch.equal(raw_x1, x1[samples[[0, 2]]])
+            assert torch.equal(raw_x2, x2[samples[[0, 2]]])
+            return [None, torch.eye(3, dtype=torch.float64)]
+
+        monkeypatch.setattr(ransac_module, "_h_degenerate_samples", check)
+        eligible = RANSAC._degensac_lo_mask(models, samples, x1, x2, 1.0)
+        assert eligible.tolist() == [True, False, False]
